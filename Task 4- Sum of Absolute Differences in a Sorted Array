class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];

        int totalSum = 0;

        for (int num : nums) {
            totalSum += num;
        }

        int leftSum = 0;

        for (int i = 0; i < n; i++) {
            int current = nums[i];

            int left = i * current - leftSum;

            int rightSum = totalSum - leftSum - current;

            int right = rightSum - (n - i - 1) * current;

            result[i] = left + right;

            leftSum += current;
        }

        return result;
    }
}
